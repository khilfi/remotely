# Treat everything committed here as public: git history is forever. See "Public repository rules" in
# CLAUDE.md.

# ---- Build output ----
node_modules/
dist/
dist-ssr/
target/
src-tauri/target/
src-tauri/gen/schemas/
*.local

# ---- Secrets and keys: never commit ----
.env*
*.key
*.pem
*.pfx
*.p12
*.ppk
id_rsa*
id_ed25519*
id_ecdsa*

# ---- Real session exports (PuTTY, MobaXterm) ----
*.reg
*.mxtsessions

# ---- App data: databases, logs, recordings, exports ----
*.db
*.db-shm
*.db-wal
*.sqlite*
*.log
logs/
*.cast
exports/
support-bundles/
# FD-07 encrypted export between laptops (remotely-export-<date>.remotely)
*.remotely
# AP-05 audit export, BX-05 Compare and QL-12 MultiExec exports (CSV, JSON, HTML)
remotely-audit-*.csv
remotely-run-*
remotely-multiexec-*
# RDP connection files (v3: mstsc.exe with a generated .rdp)
*.rdp

# ---- Local setup files (kept out of git) ----
START_HERE.md
STARTER_PROMPT.md
CLAUDE.local.md
.claude/worktrees/
.claude/settings.local.json
vm-ssh-manager-starter/
vm-ssh-manager-starter.zip

# ---- Editors and OS ----
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
